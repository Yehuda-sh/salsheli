# ----------------------------
# Firebase
# ----------------------------
# Service-account keys — real secrets, never commit:
scripts/firebase-service-account.json
serviceAccountKey.json
firebase-service-account.json

# Local-only emulator data + debug logs:
emulator-data/
functions/firebase-debug.log

# Config files — google-services.json + firebase_options.dart are
# already tracked (needed for build, not actually secret since Firebase
# config is bundled in the APK). These rules are defensive — prevent
# adding new/forked copies in other paths.
**/google-services.json
**/GoogleService-Info.plist
lib/firebase_options.dart

# ----------------------------
# Certificates / profiles
# ----------------------------
*.p12
*.pem
*.cert
*.mobileprovision

