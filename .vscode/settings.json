{
  // 🌍 Spell check (Disabled for Hebrew)
  "cSpell.enabled": false,

  // 🎨 General Editor UI & Formatting
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,

  // 🎨 Flutter/Dart Specific Settings
  "dart.lineLength": 80,
  "dart.closingLabels": true,
  "dart.previewFlutterUiGuides": true,
  "editor.rulers": [80],

  // ⚙️ Dart Specific Configurations
  "[dart]": {
    "editor.formatOnType": true,
    "editor.selectionHighlight": false,
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "editor.suggestSelection": "first",
    "editor.tabCompletion": "onlySnippets",
    "editor.wordBasedSuggestions": "off",
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    }
  },

  // 🔍 Exclude folders from Search (Optimized for Flutter, Node, Python)
  "search.exclude": {
    "**/.dart_tool": true,
    "**/build": true,
    "**/.flutter-plugins": true,
    "**/.flutter-plugins-dependencies": true,
    "**/*.g.dart": true,
    "**/*.freezed.dart": true,
    "**/node_modules": true,
    "**/__pycache__": true,
    "**/.venv": true,
    "**/venv": true
  },

  // 📂 Exclude folders from File Explorer
  "files.exclude": {
    "**/.dart_tool": true,
    "**/.flutter-plugins": true,
    "**/.flutter-plugins-dependencies": true,
    "**/.packages": true,
    "**/pubspec.lock": false,
    "**/node_modules": true,
    "**/__pycache__": true,
    "**/.venv": true
  },

  // 🔧 System & Tooling
  "git.ignoreLimitWarning": true,
  "java.configuration.updateBuildConfiguration": "automatic"
}
